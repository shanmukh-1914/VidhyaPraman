# ==============================================================================
# Vidhya Praman - Unified Platform Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root and fill in the required keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Database & Security Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-django-production-secret-key-change-this-in-prod
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-signing-secret-key-change-this-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# 3. Third-Party OAuth Identity Providers (Optional for local dev)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth App Credentials (for verified repo sync & developer identity)
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. Multi-Provider LLM Inference Gateways
# (The platform supports Groq, NVIDIA NIM, OpenAI, OpenRouter, and Gemini)
# ------------------------------------------------------------------------------
# Groq API Gateway (ultra-low latency inference)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM / DeepSeek Gateway
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI Gateway (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Gateway (optional alternative)
ANTHROPIC_API_KEY=

# OpenRouter / Gemini (optional alternatives)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# LLM Execution Configuration
LLM_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 5. Frontend Environment Configuration (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_DJANGO_URL=http://localhost:8001
VITE_ENABLE_WEBCAM_PROCTORING=true
