[Unit]
Description=Vidhya Praman FastAPI AI/ML Engine
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/vidhyapraman
EnvironmentFile=/var/www/vidhyapraman/.env
ExecStart=/var/www/vidhyapraman/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
