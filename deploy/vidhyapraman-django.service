[Unit]
Description=Vidhya Praman Django Database & Auth Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/vidhyapraman/server_django
EnvironmentFile=/var/www/vidhyapraman/.env
ExecStart=/var/www/vidhyapraman/.venv/bin/gunicorn skillforge_backend.wsgi:application --bind 127.0.0.1:8001 --workers 1 --threads 2 --timeout 60
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
