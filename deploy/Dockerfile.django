# ==============================================================================
# Dockerfile for Vidhya Praman Django Database & Auth Service
# ==============================================================================
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir gunicorn django djangorestframework django-cors-headers requests pyjwt pydantic

COPY server_django/ ./server_django/
COPY .env ./server_django/.env

WORKDIR /app/server_django

RUN python manage.py migrate --noinput && \
    python manage.py collectstatic --noinput

EXPOSE 8001

CMD ["gunicorn", "skillforge_backend.wsgi:application", "--bind", "0.0.0.0:8001", "--workers", "1", "--threads", "2"]
